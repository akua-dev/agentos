{
  "name": "@agentos/root",
  "version": "0.0.0",
  "description": "AgentOS runtime, optional services, executable primitives, and database workspace",
  "private": true,
  "type": "module",
  "workspaces": ["clis/*", "database", "packages/*", "services/*"],
  "scripts": {
    "build": "bun run --filter @akua-dev/agentos-pi build",
    "test": "bun run build && bun test .",
    "typecheck": "tsc --project tsconfig.json",
    "check": "bun run test && bun run typecheck"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@akua-dev/agentos-pi": "workspace:*",
    "ajv": "8.20.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
