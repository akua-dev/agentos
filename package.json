{
  "name": "@agentos/root",
  "version": "0.0.0",
  "description": "AgentOS runtime, optional services, executable primitives, and database workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "clis/*",
    "database",
    "packages/*",
    "services/*",
    "vendor/codex-router/packages/*",
    "website/apps/docs"
  ],
  "scripts": {
    "build": "bun run --filter @akua-dev/agentos build",
    "test": "bun run build && bun test . ./packages/agentos/src/background-tasks ./packages/agentos/src/supervision-guard ./packages/agentos/src/openai-server-compaction ./packages/agentos/src/mate-memory --path-ignore-patterns='website/apps/docs/**' --path-ignore-patterns='vendor/codex-router/**' && bun run router:test && bun run site:test",
    "router:test": "vitest run --config vendor/codex-router/vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json",
    "check": "bun run test && bun run typecheck && bun run site:lint && bun run site:typecheck",
    "site:dev": "bun run --cwd website/apps/docs dev",
    "site:test": "bun run --cwd website/apps/docs test",
    "site:lint": "bun run --cwd website/apps/docs lint",
    "site:typecheck": "bun run --cwd website/apps/docs types:check",
    "site:build": "bun run --cwd website/apps/docs build",
    "site:build:worker": "bun run --cwd website/apps/docs build:worker",
    "site:deploy": "bun run --cwd website/apps/docs deploy",
    "site:deploy:worker": "bun run --cwd website/apps/docs deploy:worker",
    "site:preview:worker": "bun run --cwd website/apps/docs preview:worker",
    "site:upload:worker": "bun run --cwd website/apps/docs upload:worker"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.102",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@akua-dev/agentos": "workspace:*",
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "ajv": "8.20.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
