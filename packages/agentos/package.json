{
  "name": "@akua-dev/agentos",
  "version": "0.1.0",
  "description": "The Pi-native AgentOS extension, public API, and released resources",
  "type": "module",
  "sideEffects": false,
  "keywords": ["pi-package"],
  "files": [
    "dist",
    "extensions",
    "resources",
    "runtime",
    "skills",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ./build.ts",
    "prepack": "bun run build",
    "test": "bun test tests src runtime/tests resources"
  },
  "pi": {
    "extensions": ["./extensions/agentos.ts"],
    "skills": ["./skills"]
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
