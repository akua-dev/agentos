{
  "name": "docs",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "scripts": {
    "brand:generate": "bun ./scripts/generate-brand-assets.ts",
    "build": "fumadocs-mdx && next build --webpack",
    "build:worker": "fumadocs-mdx && opennextjs-cloudflare build && bun ./scripts/finalize-worker-build.ts",
    "types:check": "next typegen && tsc --noEmit",
    "clean": "rimraf .next",
    "deploy": "bun run build:worker && bun run deploy:worker",
    "deploy:worker": "bun ./scripts/publish-worker.ts production",
    "dev": "next dev",
    "lint": "bun ./scripts/lint.entry.ts",
    "preview:worker": "opennextjs-cloudflare preview",
    "test": "vitest run --config vitest.config.ts",
    "upload:worker": "bun ./scripts/publish-worker.ts preview",
    "verify:site": "bun ./scripts/site-contract.ts",
    "start": "next start"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@base-ui/react": "^1.6.0",
    "@fumadocs/satteri": "0.5.0",
    "@paper-design/shaders-react": "^0.0.80",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.2.0",
    "effect": "4.0.0-rc.112",
    "fumadocs-core": "16.15.8",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-twoslash": "3.3.1",
    "fumadocs-typescript": "5.4.0",
    "fumadocs-ui": "16.15.8",
    "katex": "0.18.7",
    "lucide-react": "^1.25.0",
    "mermaid": "^11.16.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "posthog-js": "1.428.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satteri": "^0.10.0",
    "shiki": "^4.3.1",
    "twoslash": "^0.3.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@fumadocs/cli": "1.5.0",
    "@next/bundle-analyzer": "16.3.4",
    "@next/env": "16.3.4",
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "browserslist-config-baseline": "^0.5.0",
    "jsdom": "^28.1.0",
    "next-validate-link": "^1.6.6",
    "postcss": "^8.5.21",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tinyexec": "^1.2.4",
    "tinyglobby": "^0.2.17",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  },
  "browserslist": [
    "extends browserslist-config-baseline/2024"
  ]
}
